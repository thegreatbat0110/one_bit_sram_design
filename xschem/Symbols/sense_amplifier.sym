T {VDD} -125 -24 0 0 0.2 0.2 {}
B 5 147.5 -2.5 152.5 2.5 {name=blb dir=inout}
L 7 130 0 150 0 {}
T {blb} 125 -4 0 1 0.2 0.2 {}
B 5 147.5 17.5 152.5 22.5 {name=bl dir=inout}
